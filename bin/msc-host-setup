#!/bin/bash
## Usage {{{
### NAME
###     msc-host-setup - Setup host according to a host-setup directory
###
### SYNOPSIS
###     msc-host-setup [options] [hostname]
###
### DESCRIPTION
###     Setup host according to host-setup directory.
###
###     Under the host-setup directory, the structure looks like
###     + common
###     | + etc
###     | | + my-sys-cfg
###     | + ...
###     + host.d
###     | + host1
###     | | + etc
###     | | | + my-sys-cfg
###     | | | + ....
###     | + ...
###
###     The setting files that applied to all hosts are under common/;
###     and the host specific files are under host.d/<hostname>/
###
### ARGUMENTS
###     hostname: Name of the host.
###  
### ENVIRONMENTS
###     MSC_HOST_SETUP_DIR
###         Location of MSC host-setup directory.
###         Default: /etc/my-sys-cfg/host-setup
: ${MSC_HOST_SETUP_DIR:=/etc/my-sys-cfg/host-setup}
###
### AUTHOR
###     Ding-Yi Chen (definite), dingyichen@gmail.com
###     Created in 2023-01-13 17:33:17
###
## }}}
## MSC header {{{
set -eu # Exit when returns non-zero, Error when variable is unset.
MSC_LOG_PREFIX="[msc-host-setup] "

## Setup my-cfg-sys environment
eval "$($(dirname $(realpath ${BASH_SOURCE[0]}))/msc-env-find -f)"
## }}}

## Function Start {{{
get_mode(){
  local dir="$1"
  if [ ! -r $dir ]; then
    echo ""  # Not exist, just skip 
  elif [ -r "$dir/msc-setup.sh" ]; then
    echo "sh"
  elif [ -r "$dir/Makefile" ]; then
    echo "make"
  else
    echo "cp"
  fi
}

## }}}

## Parse Start {{{
###
### OPTIONS
MSC_LOG_LEVEL=notice
Mode=
Sudo=
Target=
Action=
Force=
NoRestorecon=
##
Hostname=$(hostname -s)
## PerformedActionArray
##   It is possible that some files only exist in either common or host specific.
##   Showing the success one on notice level won't make users think why it failed.
declare -a PerformedActionArray

while getopts 'hist:v:fZCd' opt; do
  case $opt in
    h)
      ###     -h: Print usage
      msc_help_print $0
      exit $MSC_EXIT_OK
      ;;
    i)
      ###
      ###     -i: Install to target
      Action=install
      ;;
    s)
      ###
      ###     -s: Sudo mode
      Sudo=/usr/bin/sudo
      ;;
    t)
      ###
      ###     -t <path>: Update target path
      ###       For example, -t /etc/my-sys-cfg copies corresponding host-setup files to /etc/my-sys-cfg.
      Target="$OPTARG"
      ;;
    v)
      ###
      ###     -v <level>: Log level
      ###        Available: debug1, debug, info, notice:
      ###          err, crit, alert, emerg
      ###        Default: notice
      MSC_LOG_LEVEL=$OPTARG
      ;;
    f)
      ###
      ###     -f: Force overwrite existing files
      Force=1
      ;;
    Z)
      ###
      ###     -Z: Skip SELinux restorecon (restorecon is applied by default)
      NoRestorecon=1
      ;;
    C)
      ###
      ###     -C: Copy target files back to source
      Action=copy-to-source
      ;;
    d)
      ###
      ###     -d: Show diff between source and target
      Action=diff
      ;;
  esac
done

shift $((OPTIND - 1))

if [[ -z $Action ]]; then
  msc_help_print $0
  exit $MSC_EXIT_OK
fi

Subcommand=$Action
if [[ $Action == "install" ]]; then
  if [[ -n $Force ]] && [[ -z $NoRestorecon ]]; then
    Subcommand=se-install-force
  elif [[ -n $Force ]]; then
    Subcommand=install-force
  elif [[ -z $NoRestorecon ]]; then
    Subcommand=se-install
  fi
fi

if [[ -n "${1-}" ]]; then
  Hostname="$1"
  shift
fi

msc_log "Host setup directory=$MSC_HOST_SETUP_DIR" info
msc_log "Subcommand=$Subcommand LogLevel=$MSC_LOG_LEVEL Sudo=$Sudo" debug
## }}}
## Main {{{

for p in $MSC_HOST_SETUP_DIR/common/$Target $MSC_HOST_SETUP_DIR/hosts.d/$Hostname/$Target; do
  if [[ ! -r $p ]]; then
    msc_log " path=$p is not readable, skip" info
    continue
  fi
  if [[ -f $p ]]; then
    case $Subcommand in
      install|install-force|se-install|se-install-force)
        Cmd="$Sudo cp $p $Target"
        msc_log " $Cmd" debug
        eval "$Cmd"
        PerformedActionArray+=( "$Cmd" )
        ;;
      restorecon)
        restorecon -v "$Target"
        ;;
      copy-to-source)
        Cmd="cp $Target $p"
        msc_log " $Cmd" debug
        eval "$Cmd"
        PerformedActionArray+=( "$Cmd" )
        ;;
      diff)
        diff "$p" "$Target" || true
        ;;
    esac
    case $Subcommand in
      se-install|se-install-force)
        restorecon -v "$Target"
        ;;
    esac
    continue
  fi
  Mode="$(get_mode $p)"
  msc_log " path=$p mode=$Mode" debug

  if [[ -z $Mode ]]; then
    msc_log " no host-setup files found in directory $p" warning
    continue
  fi

  cd $p
  case $Mode in
    sh)
      msc_log " running msc-setup.sh $Subcommand" info
      $Sudo ./msc-setup.sh $Subcommand
      ;;
    make)
      $Sudo make $Subcommand
      ;;
    cp)
      case $Subcommand in
        install|se-install)
          $Sudo cp -Rv * .
          ;;
        install-force|se-install-force)
          $Sudo cp -Rvf * .
          ;;
        *)
          msc_log " subcommand $Subcommand not supported for cp mode" warning
          ;;
      esac
      case $Subcommand in
        se-install|se-install-force|restorecon)
          if command -v restorecon &>/dev/null; then
            restorecon -Rv .
          fi
          ;;
      esac
      ;;
  esac
  cd -
done

msc_log "Performed Actions:" notice
msc_log "$(printf '  %s\n' "${PerformedActionArray[@]}")" notice
## }}}
